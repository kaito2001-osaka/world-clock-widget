<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WorldClockSettings</RootNamespace>
    <AssemblyName>WorldClockSettings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icons\worldclock.ico</ApplicationIcon>
    <!-- Unpackaged, framework-dependent: relies on the installed .NET Desktop runtime. -->
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Product>World Clock Gadget</Product>
    <Copyright>Copyright (c) 2026 Kaito Ito. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window can show it via the pack:// URI below. -->
    <Resource Include="..\..\icons\worldclock.ico" Link="worldclock.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
