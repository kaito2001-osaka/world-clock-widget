<ui:FluentWindow x:Class="WorldClockSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WorldClockSettings"
        Title="{x:Static local:Strings.WindowTitle}"
        Icon="pack://application:,,,/worldclock.ico"
        Width="560" Height="720"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static local:Strings.WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/worldclock.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" Padding="20,8,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Cities -->
                <TextBlock Text="{x:Static local:Strings.Cities}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8" />
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <ListView x:Name="CitiesList" Height="170"
                                  SelectionMode="Single"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tz}"
                                                   Opacity="0.6" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Margin="12,0,0,0" />
                                        <ui:SymbolIcon Grid.Column="2" Symbol="Warning24"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Visibility="{Binding HasUnknownTz, Converter={StaticResource BoolToVisibility}}"
                                                       ToolTip="{x:Static local:Strings.UnknownTzTip}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CityPicker" Grid.Column="0"
                                      IsEditable="True" IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      ToolTip="{x:Static local:Strings.CityPickerTip}" />
                            <ui:Button Grid.Column="1" x:Name="AddButton" Content="{x:Static local:Strings.Add}"
                                       Margin="8,0,0,0" Click="OnAddCity" />
                            <ui:Button Grid.Column="2" x:Name="RemoveButton" Content="{x:Static local:Strings.Remove}"
                                       Margin="8,0,0,0" Click="OnRemoveCity" />
                        </Grid>
                        <ui:InfoBar x:Name="CityError" Severity="Error"
                                    IsClosable="False" IsOpen="False"
                                    Title="{x:Static local:Strings.CannotAddCity}"
                                    Margin="0,8,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static local:Strings.ReorderHint}"
                                       Opacity="0.6" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="↑" Click="OnMoveUp" Margin="0,0,8,0" />
                                <ui:Button Content="↓" Click="OnMoveDown" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Display -->
                <TextBlock Text="{x:Static local:Strings.Display}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8" />
                <ui:Card Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Strings.DisplayMode}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="ModeDigital" Content="{x:Static local:Strings.Digital}"
                                         GroupName="Mode" Margin="0,0,16,0"
                                         Checked="OnModeChanged" />
                            <RadioButton x:Name="ModeAnalog" Content="{x:Static local:Strings.Analog}"
                                         GroupName="Mode" Checked="OnModeChanged" />
                        </StackPanel>
                        <ui:InfoBar x:Name="AnalogWarning" Severity="Warning"
                                    IsClosable="False" IsOpen="False"
                                    Title="{x:Static local:Strings.AnalogWarningTitle}"
                                    Message="{x:Static local:Strings.AnalogWarningMessage}"
                                    Margin="0,4,0,8" />

                        <Separator Margin="0,8" />

                        <TextBlock Text="{x:Static local:Strings.Arrangement}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LayoutVertical" Content="{x:Static local:Strings.Vertical}"
                                         GroupName="Layout" Margin="0,0,16,0" />
                            <RadioButton x:Name="LayoutHorizontal" Content="{x:Static local:Strings.Horizontal}"
                                         GroupName="Layout" />
                        </StackPanel>

                        <Separator Margin="0,8" />

                        <ui:ToggleSwitch x:Name="Toggle24"   Content="{x:Static local:Strings.Hour24}" Margin="0,4" />
                        <ui:ToggleSwitch x:Name="ToggleDate" Content="{x:Static local:Strings.ShowDate}" Margin="0,4"
                                         Checked="OnShowDateChanged" Unchecked="OnShowDateChanged" />

                        <StackPanel x:Name="DateFormatPanel" Margin="24,2,0,4">
                            <TextBlock Text="{x:Static local:Strings.DateFormat}" FontWeight="SemiBold" Margin="0,4,0,4" />
                            <ComboBox x:Name="DateFormatBox" IsEditable="True"
                                      SelectionChanged="OnDateFormatChanged"
                                      ToolTip="{x:Static local:Strings.DateFormatTip}" />
                            <TextBlock x:Name="DatePreview" Margin="0,6,0,0" Opacity="0.85"
                                       Text="{x:Static local:Strings.PreviewPrefix}" />
                            <TextBlock Margin="0,4,0,0" Opacity="0.55" TextWrapping="Wrap"
                                       Text="{x:Static local:Strings.TokenHelp}" />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="ToggleSeconds" Content="{x:Static local:Strings.ShowSeconds}" Margin="0,4" />

                        <Separator Margin="0,8" />

                        <TextBlock Text="{x:Static local:Strings.Size}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <RadioButton x:Name="SizeSmall"  Content="{x:Static local:Strings.Small}" GroupName="Size" Margin="0,0,16,0" />
                            <RadioButton x:Name="SizeMedium" Content="{x:Static local:Strings.Medium}" GroupName="Size" Margin="0,0,16,0" />
                            <RadioButton x:Name="SizeLarge"  Content="{x:Static local:Strings.Large}" GroupName="Size" />
                        </StackPanel>

                        <Separator Margin="0,8" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Static local:Strings.Opacity}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Width="80" />
                            <Slider Grid.Column="1" x:Name="OpacitySlider"
                                    Minimum="10" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="OnOpacityChanged"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" x:Name="OpacityValue" Text="85%"
                                       Width="48" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Behavior -->
                <TextBlock Text="{x:Static local:Strings.Window}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,8" />
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <ui:ToggleSwitch x:Name="ToggleTopmost" Content="{x:Static local:Strings.AlwaysOnTop}" Margin="0,4" />
                        <ui:ToggleSwitch x:Name="ToggleLock"    Content="{x:Static local:Strings.LockPosition}" Margin="0,4" />
                        <ui:ToggleSwitch x:Name="ToggleStartup" Content="{x:Static local:Strings.LaunchAtStartup}" Margin="0,4" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons: OK / Cancel / Apply -->
        <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource ApplicationBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="1" Content="OK" Appearance="Primary"
                           MinWidth="96" Click="OnOk" />
                <ui:Button Grid.Column="2" Content="{x:Static local:Strings.Cancel}" MinWidth="96"
                           Margin="8,0,0,0" Click="OnCancel" />
                <ui:Button Grid.Column="3" Content="{x:Static local:Strings.Apply}" MinWidth="96"
                           Margin="8,0,0,0" Click="OnApply" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
