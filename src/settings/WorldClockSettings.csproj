<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WorldClockSettings</RootNamespace>
    <AssemblyName>WorldClockSettings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\icons\worldclock.ico</ApplicationIcon>
    <!-- Unpackaged. Framework-dependent by default, as in build_all.cmd's dist\, which
         relies on the installed .NET Desktop runtime. make_installer.cmd publishes with
         dotnet publish self-contained true instead, so the installer bundles the runtime
         and an installed copy only gets .NET fixes when a rebuilt installer ships. -->
    <SelfContained>false</SelfContained>
    <Version>1.2.1</Version>
    <Product>World Clock Gadget</Product>
    <Copyright>Copyright (c) 2026 Kaito Ito. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the window can show it via the pack:// URI below. -->
    <Resource Include="..\..\icons\worldclock.ico" Link="worldclock.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

</Project>
